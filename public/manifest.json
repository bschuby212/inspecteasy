{
  "manifest_version": 3,
  "name": "Inspect Studio",
  "description": "A designer-friendly visual inspector for websites. Click elements to inspect layout, typography, spacing, and colors \u2014 without DevTools.",
  "version": "1.0.0",
  "action": {
    "default_title": "Toggle Inspect Studio",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/*",
        "fonts/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "key": ""
}
